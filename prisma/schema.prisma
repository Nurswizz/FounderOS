generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ---------------------------------- auth.js ---------------------------------- */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  startup       Startup?
  ideaSessions  IdeaSession[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/* --------------------------------- domain ------------------------------------ */

enum Stage {
  IDEA
  VALIDATION
  MVP
  LAUNCH
  GROWTH
}

enum ItemSource {
  TEMPLATE
  AI
  CUSTOM
}

enum HubKind {
  LINK
  NOTE
  CONTACT
  DOC
}

enum MetricSource {
  MANUAL
  GITHUB
}

enum Provider {
  GITHUB
}

model Startup {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  industry    String?
  stage       Stage    @default(IDEA)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmap      RoadmapItem[]
  hub          HubEntry[]
  metrics      Metric[]
  integrations Integration[]
  agentRuns    AgentRun[]
  actions      PendingAction[]
  agentConfig  AgentSetting[]
}

model RoadmapItem {
  id          String     @id @default(cuid())
  startupId   String
  startup     Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  stage       Stage
  title       String
  description String?
  order       Int        @default(0)
  source      ItemSource @default(TEMPLATE)
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([startupId, stage])
}

model HubEntry {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  kind      HubKind
  title     String
  url       String?
  body      String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([startupId, kind])
}

model Metric {
  id         String       @id @default(cuid())
  startupId  String
  startup    Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  key        String
  value      Float
  source     MetricSource @default(MANUAL)
  capturedAt DateTime     @default(now())

  @@index([startupId, key, capturedAt])
}

model Integration {
  id           String    @id @default(cuid())
  startupId    String
  startup      Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  provider     Provider
  config       Json
  lastSyncedAt DateTime?

  @@unique([startupId, provider])
}

/* --------------------------------- agents ------------------------------------ */

enum AgentKey {
  CHIEF_OF_STAFF
  MARKET_RESEARCHER
  CUSTOMER_DISCOVERY
  CTO
}

enum RunTrigger {
  MANUAL
  SCHEDULE
  DELEGATED
}

enum RunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

model AgentRun {
  id          String     @id @default(cuid())
  startupId   String
  startup     Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  agent       AgentKey
  trigger     RunTrigger @default(MANUAL)
  brief       String
  status      RunStatus  @default(QUEUED)
  output      String?
  error       String?
  // Живой статус для UI: что агент делает прямо сейчас и черновик ответа по ходу стрима.
  activity    String?
  draft       String?
  parentRunId String?
  parent      AgentRun?  @relation("Delegation", fields: [parentRunId], references: [id], onDelete: SetNull)
  children    AgentRun[] @relation("Delegation")
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  steps   AgentStep[]
  actions PendingAction[]

  @@index([startupId, agent, createdAt])
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool      String
  input     String
  output    String
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

model PendingAction {
  id         String       @id @default(cuid())
  runId      String
  run        AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  startupId  String
  startup    Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  payload    Json
  status     ActionStatus @default(PENDING)
  result     String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([startupId, status])
}

model AgentSetting {
  startupId       String
  startup         Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  agent           AgentKey
  scheduleEnabled Boolean  @default(false)

  @@id([startupId, agent])
}

/* -------------------------------- ideation ----------------------------------- */

model IdeaSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // История диалога в формате Agents SDK — передаётся модели на каждом ходе.
  history   Json     @default("[]")
  thinking  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages IdeaMessage[]
  ideas    IdeaCandidate[]

  @@index([userId, createdAt])
}

model IdeaMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   IdeaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  activity  String?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model IdeaCandidate {
  id        String      @id @default(cuid())
  sessionId String
  session   IdeaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  problem   String
  customer  String
  solution  String
  whyNow    String
  risks     String
  evidence  Json
  createdAt DateTime    @default(now())
}
